<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Odyssey's vanilla Plant_Reeds has no HSK SeedsPlease integration.
       Add a sow tag only when Odyssey is enabled. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ludeon.RimWorld.Odyssey</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Plant_Reeds"]/plant</xpath>
      <value>
        <sowTags>
          <li>Ground</li>
        </sowTags>
      </value>
    </match>
  </Operation>
</Patch>
