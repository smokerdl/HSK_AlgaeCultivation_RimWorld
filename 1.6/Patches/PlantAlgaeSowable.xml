<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- PlantAlgae inherits SK_DeciduousPlantBase, not SK_DeciduousCropPlant,
       so unlike Core_SK's normal crop defs it has no sowTags of its own.
       SeedsPlease also needs a sow tag to resolve Seed_Algae. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="PlantAlgae"]/plant/sowTags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="PlantAlgae"]/plant/sowTags</xpath>
      <value>
        <li>Ground</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="PlantAlgae"]/plant</xpath>
      <value>
        <sowTags>
          <li>Ground</li>
        </sowTags>
      </value>
    </nomatch>
  </Operation>
</Patch>
